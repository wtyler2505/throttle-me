#!/bin/bash
# throttle-me-daemon - Background daemon for automatic hotspot detection
# Monitors network connections and auto-enables bypass for mobile hotspots
# shellcheck disable=SC2310

set -euo pipefail

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source required libraries
source "${SCRIPT_DIR}/lib/logging.sh"
source "${SCRIPT_DIR}/lib/utils.sh"
source "${SCRIPT_DIR}/lib/config.sh"
source "${SCRIPT_DIR}/lib/network.sh"
source "${SCRIPT_DIR}/lib/detection.sh"

# Initialize
initialize_logging
load_config

# Daemon configuration
LOCK_FILE="${HOME}/.cache/throttle-me/daemon.lock"
STATE_FILE="${HOME}/.config/throttle-me/daemon.state"
POLL_INTERVAL=5  # seconds

# Ensure directories exist
mkdir -p "$(dirname "${LOCK_FILE}")"
mkdir -p "$(dirname "${STATE_FILE}")"

# Desktop notification helper
daemon_notify() {
    local urgency=$1
    local title=$2
    local message=$3
    local icon=${4:-network-wireless}
    
    # Send desktop notification if in graphical session
    if [[ -n "${DISPLAY:-}" ]] && command -v notify-send &>/dev/null; then
        notify-send -u "${urgency}" -t 5000 -i "${icon}" "${title}" "${message}" 2>/dev/null || true
    fi
    
    # Always log to journal
    logger -t throttle-me-daemon -p user.info "${title}: ${message}"
}

# State persistence
save_state() {
    local last_check
    last_check=$(date +%s)

    cat > "${STATE_FILE}" << EOF
LAST_SSID=${last_ssid}
BYPASS_ACTIVE=${bypass_active}
LAST_CHECK=${last_check}
EOF
}

load_state() {
    if [[ -f "${STATE_FILE}" ]]; then
        source "${STATE_FILE}"
    else
        LAST_SSID=""
        BYPASS_ACTIVE="false"
        LAST_CHECK=0
    fi
}

# Cleanup handler
cleanup() {
    log_info "Daemon shutting down gracefully..."
    rm -f "${LOCK_FILE}"
    save_state
    exit 0
}

# Signal handlers
trap cleanup SIGTERM SIGINT

# Lock file handling - prevent multiple instances
exec 200>"${LOCK_FILE}"
if ! flock -n 200; then
    existing_pid=$(cat "${LOCK_FILE}" 2>/dev/null || echo 'unknown')
    echo "ERROR: throttle-me-daemon is already running" >&2
    echo "PID: ${existing_pid}" >&2
    exit 1
fi

# Write PID to lock file
echo $$ > "${LOCK_FILE}"

# Load previous state
load_state
last_ssid="${LAST_SSID:-}"
bypass_active="${BYPASS_ACTIVE:-false}"
last_check="${LAST_CHECK:-0}"

log_info "Daemon started (PID: $$)"
log_debug "Previous daemon check timestamp: ${last_check}"
daemon_notify normal "Daemon Started" "Monitoring for mobile hotspots" "dialog-information"

# Detect wireless interface. At login this daemon starts before NetworkManager has brought the
# adapter up, so the original code logged an error and exited; systemd restarted it, it died again,
# and the bypass stayed off until a command was typed by hand (found 2026-09-17, three deaths in the
# boot log). Wait for one instead of dying.
iface=""
for _attempt in $(seq 1 60); do
    iface=$(detect_wireless_interface 2>/dev/null) && [[ -n "${iface}" ]] && break
    iface=""
    sleep 2
done
if [[ -z "${iface}" ]]; then
    log_error "No wireless interface appeared after two minutes"
    daemon_notify critical "Daemon Error" "No wireless interface found" "dialog-error"
    exit 1
fi

log_info "Monitoring interface: ${iface}"

# How the loop decides (rewritten 2026-09-17 evening, after an afternoon of it failing quietly):
#
#   The old loop was edge-triggered: it made one decision at the instant the network name changed,
#   and never looked again. If the hotspot check failed at that instant (the adapter is still
#   settling during a switch), the bypass stayed wrong until the next switch. That is exactly what
#   happened: 14:47 joining the work iPhone and 19:22 rejoining the Pixel both went unhandled.
#   It also kept the patterns from startup, so adding a hotspot name meant nothing until a restart,
#   and a startup "check the real rules" step called a function this daemon never loads.
#
#   Now it is level-triggered: every pass it asks "which network am I on, and should the bypass be
#   on for it", and it re-applies the bypass on a hotspot at least once a minute. The bypass script
#   is idempotent (it only adds rules that are missing), so re-applying is safe and cheap, and it
#   repairs a reboot, a flapping switch, or rules removed by hand. The config is re-read whenever the
#   file changes. This daemon cannot read the firewall without a password, so it never pretends to.
REAPPLY_SECONDS=60
bypass_active="unknown"
last_ssid=""
last_apply=0
config_stamp=""

apply_bypass() {
    TTL_VALUE="${CONFIG[TTL_VALUE]}" HL_VALUE="${CONFIG[HL_VALUE]:-${CONFIG[TTL_VALUE]}}" \
        DNS_SERVER="${CONFIG[DNS_SERVER]}" "${CONFIG[BYPASS_SCRIPT]}" >/dev/null 2>&1
}

remove_bypass() {
    DNS_SERVER="${CONFIG[DNS_SERVER]}" "${CONFIG[DISABLE_SCRIPT]}" >/dev/null 2>&1
}

while true; do
    stamp=$(stat -c %Y "${CONFIG_FILES[0]}" 2>/dev/null || echo "")
    if [[ "${stamp}" != "${config_stamp}" ]]; then
        [[ -n "${config_stamp}" ]] && log_info "Config changed; reloading (patterns: ${HOTSPOT_PATTERNS:-default})"
        load_config >/dev/null 2>&1 || true
        config_stamp="${stamp}"
    fi

    current_ssid=$(get_current_ssid "${iface}" 2>/dev/null || echo "")
    now=$(date +%s)

    if [[ "${current_ssid}" != "${last_ssid}" ]]; then
        log_info "SSID changed: '${last_ssid}' → '${current_ssid}'"
    fi

    if [[ -z "${current_ssid}" ]]; then
        want="off"
    elif [[ "${CONFIG[AUTO_ENABLE]}" != "true" ]]; then
        want="leave"
    elif is_mobile_hotspot "${current_ssid}"; then
        want="on"
    else
        want="off"
    fi

    if [[ "${want}" == "on" ]]; then
        if [[ "${bypass_active}" != "true" || "${current_ssid}" != "${last_ssid}" \
              || $(( now - last_apply )) -ge ${REAPPLY_SECONDS} ]]; then
            if apply_bypass; then
                if [[ "${bypass_active}" != "true" || "${current_ssid}" != "${last_ssid}" ]]; then
                    log_info "Hotspot ${current_ssid}: bypass on"
                    daemon_notify normal "Bypass Enabled" "Connected to ${current_ssid}" "network-wireless-hotspot"
                fi
                bypass_active="true"
                last_apply=${now}
            else
                log_error "Hotspot ${current_ssid}: bypass script failed; retrying next pass"
                bypass_active="false"
            fi
        fi
    elif [[ "${want}" == "off" && "${bypass_active}" != "false" ]]; then
        if remove_bypass; then
            log_info "${current_ssid:-No network}: bypass off"
            [[ "${bypass_active}" == "true" ]] && \
                daemon_notify low "Bypass Disabled" "${current_ssid:-Disconnected}" "network-wireless"
            bypass_active="false"
        else
            log_error "${current_ssid:-No network}: disable script failed; retrying next pass"
        fi
    fi

    # persist whenever the network or the bypass state changes, so the file never lies about either
    if [[ "${current_ssid}" != "${last_ssid}" || "${bypass_active}" != "${saved_bypass:-}" ]]; then
        last_ssid="${current_ssid}"
        saved_bypass="${bypass_active}"
        save_state
    fi
    sleep "${POLL_INTERVAL}"
done
